# ==============================================================================
# MAILORA AI — FRONTEND ENVIRONMENT VARIABLES
# ==============================================================================
# Supabase Project Credentials (Public / Publishable)
# Used by frontend client to connect to Supabase Auth, PostgreSQL, Storage & Functions
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Custom Edge Functions Base URL (Defaults to ${VITE_SUPABASE_URL}/functions/v1)
VITE_FUNCTIONS_BASE_URL=

# App Environment: "development" | "production"
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# SECURITY NOTE:
# NEVER put GEMINI_API_KEY or SUPABASE_SERVICE_ROLE_KEY here.
# Server secrets must ONLY be configured in Supabase Secrets:
#   supabase secrets set GEMINI_API_KEY="your-gemini-api-key"
# ==============================================================================
